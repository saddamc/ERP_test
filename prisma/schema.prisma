datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  PRESIDENT
  SECRETARY
  FINANCE
  ADMIN
}

model User {
  id           String      @id @default(uuid())
  username     String      @unique
  fullName     String
  email        String?     @unique
  phone        String?
  passwordHash String
  role         UserRole    @default(FINANCE)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  vouchers     Voucher[]
  auditLogs    AuditLog[]
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  EXPIRED
}

model Member {
  id             String        @id @default(uuid())
  accountNo      String        @unique // e.g. PM-029
  prefix         String?       // e.g. PM
  title          String?       // Mr. / Dr. / Major
  firstName      String
  middleName     String?
  lastName       String
  fullName       String
  bloodGroup     String?
  profession     String?
  creditLimit    Decimal       @default(0.00) @db.Decimal(12, 2)
  status         MemberStatus  @default(ACTIVE)

  address        String?
  city           String?
  phone          String?
  email          String?

  spouses        MemberSpouse[]
  children       MemberChild[]
  references     MemberReference[]
  nominees       MemberNominee[]
  
  ledgerEntries  MemberLedgerEntry[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model MemberSpouse {
  id             String    @id @default(uuid())
  memberId       String
  spouseIndex    Int       // 1 or 2
  name           String
  dob            DateTime?
  mobile         String?
  bloodGroup     String?
  anniversary    DateTime?
  email          String?
  signatureUrl   String?
  member         Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model MemberChild {
  id             String    @id @default(uuid())
  memberId       String
  childIndex     Int       // 1 to 4
  name           String
  dob            DateTime?
  gender         String?
  member         Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model MemberReference {
  id             String    @id @default(uuid())
  memberId       String
  refMemberNo    String?
  refName        String
  phone          String?
  member         Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model MemberNominee {
  id             String    @id @default(uuid())
  memberId       String
  name           String
  relation       String
  phone          String?
  sharePercent   Decimal   @default(100.00) @db.Decimal(5, 2)
  member         Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

enum AccountCategory {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

model AccountHead {
  id            String               @id @default(uuid())
  code          String               @unique // e.g. 1001, 1002, 5101
  name          String               // e.g. Cash in Hand, Dining Income
  category      AccountCategory
  isControlHead Boolean              @default(false)
  parentId      String?
  parent        AccountHead?         @relation("COAHierarchy", fields: [parentId], references: [id])
  children      AccountHead[]        @relation("COAHierarchy")
  
  voucherLines  VoucherLine[]
  glEntries     GeneralLedgerEntry[]
  financialAccounts FinancialAccount[]
  createdAt     DateTime             @default(now())
}

enum VoucherType {
  JOURNAL      // J3
  CASH_PAYMENT // P1 / CP
  CASH_RECEIVE // R1 / CR
  BANK_PAYMENT // P2 / BP
  BANK_RECEIVE // R2 / BR
  CONTRA       // C3 / CV
}

enum VoucherStatus {
  DRAFT
  QUEUED
  POSTED
  CANCELLED
}

model Voucher {
  id            String               @id @default(uuid())
  voucherNo     String               @unique // e.g. J3-7, P1-3, R1-2, P2-5, R2-4, C3-6
  voucherType   VoucherType
  voucherDate   DateTime
  bankCode      String?
  bankName      String?
  paymentTo     String?
  narration     String
  status        VoucherStatus        @default(DRAFT)
  totalAmount   Decimal              @db.Decimal(14, 2)
  
  createdById   String
  createdBy     User                 @relation(fields: [createdById], references: [id])
  postedAt      DateTime?
  cancelledAt   DateTime?
  cancelReason  String?

  lines         VoucherLine[]
  glEntries     GeneralLedgerEntry[]
  memberLedgers MemberLedgerEntry[]
  allocations   PaymentAllocation[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

model VoucherLine {
  id          String      @id @default(uuid())
  voucherId   String
  voucher     Voucher     @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  accountId   String
  account     AccountHead @relation(fields: [accountId], references: [id])
  description String?
  debit       Decimal     @default(0.00) @db.Decimal(14, 2)
  credit      Decimal     @default(0.00) @db.Decimal(14, 2)
}

model GeneralLedgerEntry {
  id                 String            @id @default(uuid())
  voucherId          String
  voucher            Voucher           @relation(fields: [voucherId], references: [id], onDelete: Restrict)
  accountId          String
  account            AccountHead       @relation(fields: [accountId], references: [id])
  financialAccountId String?
  financialAccount   FinancialAccount? @relation(fields: [financialAccountId], references: [id])
  reconciledAt       DateTime?
  entryDate          DateTime
  debit              Decimal           @default(0.00) @db.Decimal(14, 2)
  credit             Decimal           @default(0.00) @db.Decimal(14, 2)
  narration          String?
  createdAt          DateTime          @default(now())
}

enum SubLedgerType {
  SUBSCRIPTION
  DINING
  CARD_ROOM
}

model MemberLedgerEntry {
  id             String        @id @default(uuid())
  memberId       String
  member         Member        @relation(fields: [memberId], references: [id], onDelete: Restrict)
  voucherId      String?
  voucher        Voucher?      @relation(fields: [voucherId], references: [id])
  ledgerType     SubLedgerType
  entryDate      DateTime
  description    String
  debit          Decimal       @default(0.00) @db.Decimal(12, 2)
  credit         Decimal       @default(0.00) @db.Decimal(12, 2)
  runningBalance Decimal       @db.Decimal(12, 2)
  createdAt      DateTime      @default(now())
}

model PaymentAllocation {
  id                 String   @id @default(uuid())
  voucherId          String
  voucher            Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  memberId           String
  subscriptionAmount Decimal  @default(0.00) @db.Decimal(12, 2)
  diningAmount       Decimal  @default(0.00) @db.Decimal(12, 2)
  cardRoomAmount     Decimal  @default(0.00) @db.Decimal(12, 2)
  advanceAmount      Decimal  @default(0.00) @db.Decimal(12, 2)
}

model NotificationLog {
  id          String    @id @default(uuid())
  memberId    String?
  recipient   String
  channel     String    @default("SMS") // SMS / WhatsApp
  message     String
  status      String    @default("PENDING") // PENDING, SENT, FAILED
  gatewayRef  String?
  sentAt      DateTime?
  error       String?
  createdAt   DateTime  @default(now())
}

model AuditLog {
  id          String    @id @default(uuid())
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
  action      String
  entityType  String
  entityId    String
  oldValues   Json?
  newValues   Json?
  ipAddress   String?
  createdAt   DateTime  @default(now())
}

enum FinancialAccountType {
  CASH
  BANK
  MOBILE_WALLET
}

model FinancialAccount {
  id                 String               @id @default(uuid())
  name               String               // e.g. "Sonali Bank - Main Operational A/C"
  type               FinancialAccountType @default(BANK)
  provider           String?              // e.g. "Sonali Bank", "Dhaka Bank", "bKash"
  accountNumber      String?              // e.g. "0123456789"
  accountCode        String?              // e.g. "1101"
  bankIdentifierCode String?              // Routing / Branch code
  branchName         String?              // e.g. "Uttara Branch"
  isPrimary          Boolean              @default(false)
  openingBalance     Decimal              @default(0.00) @db.Decimal(14, 2)
  currentBalance     Decimal              @default(0.00) @db.Decimal(14, 2)
  status             String               @default("ACTIVE") // ACTIVE, INACTIVE
  notes              String?
  
  accountHeadId      String?
  accountHead        AccountHead?         @relation(fields: [accountHeadId], references: [id])
  
  glEntries          GeneralLedgerEntry[]
  
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}
